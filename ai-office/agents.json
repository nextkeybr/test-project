{
  "settings": {
    "port": 3939,
    "leadAgent": "secretary",
    "maxParallel": 3,
    "taskTimeoutMinutes": 30,
    "maxRounds": 4,
    "fallback": { "codex": "claude" }
  },
  "engines": {
    "claude": {
      "label": "Claude Code",
      "cmd": "claude",
      "args": ["-p", "{PROMPT}", "--output-format", "stream-json", "--verbose", "--permission-mode", "dontAsk", "--allowedTools", "Read,Write,Edit,MultiEdit,Glob,Grep,WebSearch,WebFetch,TodoWrite,Bash(ls:*),Bash(mkdir:*),Bash(cat:*),Bash(node:*),Bash(python3:*),Bash(npm:*),Bash(npx:*)"],
      "parser": "claude-stream",
      "roleFile": "CLAUDE.md"
    },
    "codex": {
      "label": "Codex CLI",
      "cmd": "codex",
      "args": ["--search", "exec", "--sandbox", "workspace-write", "--skip-git-repo-check", "--output-last-message", "{RESULT_FILE}", "{PROMPT}"],
      "parser": "text",
      "resultFromFile": true,
      "roleFile": "AGENTS.md"
    },
    "gemini": {
      "label": "Gemini CLI",
      "cmd": "gemini",
      "args": ["-p", "{PROMPT}", "--approval-mode", "auto_edit"],
      "parser": "text",
      "roleFile": "GEMINI.md"
    }
  },
